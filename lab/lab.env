# lab.env — range configuration for the runner.
#
# This file is sourced by the per-scenario runners (dispatched by Draghunt, or
# by lab/dealer.sh for manual runs). It runs FROM Barad-dûr (the Kali attacker).
# Edit the values to match your range if they ever drift from LabArchitecture.md.
# Draghunt's own settings (catalog path, Wazuh agent_id, indexer URL, credential,
# reset mode) live in its profile at ~/.config/draghunt/range.toml, not here.
#
# Nothing here is a real credential. The SSH key below is a throwaway lab key,
# not a key you use anywhere else.

# ---- Range addresses (see LabArchitecture.md) --------------------------------
ATTACKER_IP="192.168.45.75"     # Barad-dûr — this box, the adversary/C2
VICLIN_IP="192.168.45.74"       # Moria     — Ubuntu victim (Wazuh agent + auditd)
VICWIN_IP="192.168.45.73"       # Erebor    — Windows 11 victim (Wazuh agent + Sysmon)
WAZUH_IP="192.168.45.53"        # Amon Hen  — Wazuh manager/indexer/dashboard
VICLIN2_IP="192.168.45.78"      # optional second Linux victim for S08 SSH pivot (build when needed)
LLM_IP="192.168.45.77"          # optional LLM app host for S10 (planned)

# ---- Remote execution from Barad-dûr ----------------------------------------
# Key-based SSH into the victims. Generate once on Barad-dûr:
#   ssh-keygen -t ed25519 -f ~/.ssh/lab_id_ed25519 -N ''
# then install the public key on each victim's admin account (lab-only).
SSH_KEY="${HOME}/.ssh/lab_id_ed25519"
VICLIN_USER="labadmin"          # sudo-capable admin on Moria (for setup/cleanup)
VICLIN2_USER="labadmin"
VICWIN_USER="labadmin"          # admin on Erebor; requires OpenSSH Server enabled (see runners/README)
FOOTHOLD_USER="svc-backup"      # the weak/seeded account the scenarios pivot through

SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o BatchMode=yes"

# ---- Attacker staging (download cradles, second-stage payloads) -------------
STAGE_HTTP_PORT="8000"
STAGE_DIR="${HOME}/lab-stage"   # files served over http://ATTACKER_IP:STAGE_HTTP_PORT/

# ---- Ground truth ------------------------------------------------------------
# Sealed here on Barad-dûr and never investigated from this box, so morning-you
# stays blind. Git-ignored; it must never be pushed.
SEAL_DIR="lab/.groundtruth"
